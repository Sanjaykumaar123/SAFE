# Copy to .env. EXPO_PUBLIC_* vars are inlined into the JS bundle/native
# build — never put a secret that isn't safe to ship on-device in here.

# Shared SafePath backend (§01/§04/§60/§80 — the Admin app is a pure HTTP
# client of the common platform; it never opens a database connection and
# never talks to another SafePath app directly). 10.0.2.2 is the Android
# emulator's alias for the host machine's localhost; use your LAN IP for a
# physical device.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# When the backend above is unreachable, admin screens fall back to a
# realistic in-app dataset spanning multiple Indian cities (see
# services/demo/mockData.ts) so the full product can be demoed end-to-end
# without a running backend. Login also accepts any of the seeded demo
# admin accounts in this mode (see services/demo/mockData.ts::DEMO_ADMINS).
EXPO_PUBLIC_DEMO_MODE=true

# Google Maps SDK key (enable "Maps SDK for Android" + "Maps SDK for iOS" on
# the same key). Without it Android shows a blank map, iOS falls back to
# Apple Maps. Native config — requires a rebuild after setting, not picked
# up by a JS reload.
EXPO_PUBLIC_MAP_KEY=

# Optional: OpenStreetMap Nominatim endpoint used for place search when
# DEMO_MODE is off and the backend has no /admin/maps/geocode of its own
# yet. Left pointed at the public instance by default — swap for a
# self-hosted one in production (public Nominatim disallows heavy use).
EXPO_PUBLIC_GEOCODE_URL=https://nominatim.openstreetmap.org

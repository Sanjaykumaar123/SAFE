# Copy to .env. EXPO_PUBLIC_* vars are inlined into the JS bundle/native
# build — never put a secret that isn't safe to ship on-device in here.

# Shared SafePath backend (the same one apps/citizen-mobile in the sibling
# `citizen app` repo talks to — see ../citizen app/backend/api). This app
# never connects to a database directly; it only ever calls this API.
# 10.0.2.2 is the Android emulator's alias for the host machine's
# localhost; use your LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

EXPO_PUBLIC_DEMO_MODE=true

# Google Maps SDK key (enable "Maps SDK for Android" + "Maps SDK for iOS" on
# the same key). Without it Android shows a blank map, iOS falls back to
# Apple Maps. Native config — requires a rebuild after setting, not picked
# up by a JS reload.
EXPO_PUBLIC_MAP_KEY=

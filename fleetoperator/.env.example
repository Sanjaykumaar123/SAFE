EXPO_PUBLIC_API_URL=https://safepath-backend-latest.onrender.com/api
EXPO_PUBLIC_AI_SERVER_URL=https://safepath-ai-latest.onrender.com
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_MAP_KEY=

# mock | server | ondevice — see services/ai/index.ts. "ondevice" is not
# implemented (see DEFERRED.md) and will throw; use it only once a real
# on-device model is wired up.
EXPO_PUBLIC_AI_MODE=server

# How many AI inferences to run per second while monitoring is active
# (§09) — the camera itself still previews at full frame rate; this only
# throttles how often a frame is handed to the inference service.
EXPO_PUBLIC_AI_FRAME_RATE=5

    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "collectCoverageFrom": [
      "services/**/*.{ts,tsx}",
      "store/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "components/common/**/*.{ts,tsx}"
    ]

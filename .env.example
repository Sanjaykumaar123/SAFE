# ==============================================================================
# SafePath AI Monorepo - Root Environment Configuration Template
# Copy this file to `.env` in the root folder or use individual app .env files.
# Never commit real passwords, secrets, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE SETTINGS (FastAPI / Render Deployment)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEMO_MODE=false
API_V1_PREFIX=/api
PROJECT_NAME="SafePath AI — Citizen & City Infrastructure API"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + PostGIS / Supabase)
# ------------------------------------------------------------------------------
# Async SQLAlchemy connection URL (used by FastAPI backend)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres

# Sync SQLAlchemy connection URL (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=generate-a-secure-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 4. LARGE MEDIA STORAGE (Cloudflare R2 / S3 Bucket / Supabase Storage)
# ------------------------------------------------------------------------------
# local | s3
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=./media
STORAGE_LOCAL_BASE_URL=http://localhost:8000/media
STORAGE_BUCKET=safepath-media
STORAGE_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
STORAGE_REGION=auto

# ------------------------------------------------------------------------------
# 5. AI INFERENCE MODEL SETTINGS
# ------------------------------------------------------------------------------
# mock | yolov8 (Use 'mock' on 512MB RAM free host tiers, 'yolov8' on 2GB+ hosts)
AI_PROVIDER=mock
AI_MODEL_PATH=app/ml_models/pothole_v2_final.pt
AI_DEVICE=cpu
AI_DETECTION_CONFIDENCE=0.25
AI_IOU_THRESHOLD=0.45
AI_IMAGE_SIZE=640

# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND ORIGINS
# ------------------------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 7. FRONTEND APPS COMMON PRODUCTION URL (Citizen, Admin, Municipality, Fleet)
# ------------------------------------------------------------------------------
# Replace with your deployed Render backend URL after deployment
EXPO_PUBLIC_API_URL=https://safepath-backend-bkie.onrender.com/api
EXPO_PUBLIC_AI_PROVIDER=mock
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org

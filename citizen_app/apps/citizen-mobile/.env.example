# Copy to .env and fill in for your environment. Never commit the real .env
# (apps/citizen-mobile/.env is already git-ignored at the repo root).
# EXPO_PUBLIC_* vars are inlined into the JS bundle / native build — never
# put a secret that isn't safe to ship on-device in here.

# Backend API base URL. 10.0.2.2 is the Android emulator's alias for the
# host machine's localhost; use your LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# mock | yolov8
EXPO_PUBLIC_AI_PROVIDER=mock
EXPO_PUBLIC_DEMO_MODE=true

# Base URL of the OSRM-compatible routing server the Safe Route feature
# calls for road-snapped directions. Defaults to the public OSRM demo
# server, which is free and keyless but rate-limited and explicitly NOT for
# production use — point this at a self-hosted OSRM instance (or swap
# services/routing/osrmApi.ts for a commercial directions API) before
# shipping.
EXPO_PUBLIC_ROUTING_URL=https://router.project-osrm.org

# Copy to .env and fill in for your environment. Never commit the real .env.

# --- Database (PostgreSQL + PostGIS) ---
# Local docker-compose default — see docker-compose.yml at repo root.
DATABASE_URL=postgresql+asyncpg://safepath:safepath@localhost:5433/safepath
# Used by Alembic (sync driver) — same DB, psycopg driver.
DATABASE_URL_SYNC=postgresql+psycopg://safepath:safepath@localhost:5433/safepath

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage ---
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./media
STORAGE_LOCAL_BASE_URL=http://localhost:8000/media
# Only required when STORAGE_PROVIDER=s3 (Supabase Storage or any S3-compatible endpoint)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- AI ---
# mock | yolov8 — yolov8 runs pothole detection via the ai_model/ service
# (see app/services/ai/yolo_service.py).
AI_PROVIDER=yolov8
# URL of the standalone ai_model/ microservice (its own YOLOv8 server, e.g.
# ai_model/web_app.py deployed separately — see AI_SERVER_URL in that
# service's own README/Dockerfile). When set (the default/recommended
# config), every /ai/analyze and /ai/detect call is sent to this server's
# POST /api/detect first — this is what actually serves the APK.
# Leave empty only to force the in-process bundled checkpoint below
# (AI_MODEL_PATH) — requires `pip install -r requirements.txt` to have
# installed ultralytics/torch (heavy). Even with AI_SERVER_URL set, the
# bundled checkpoint is still kept as an automatic fallback for whenever
# the remote server is unreachable or times out.
AI_SERVER_URL=
# Only read when AI_PROVIDER=yolov8. Relative to backend/api/, or absolute
# — point this at a different checkpoint (e.g. a later training run) to
# swap models without any code change.
# best.pt is byte-identical to ai_model/model/pothole_v2_training.pt.
AI_MODEL_PATH=app/ml_models/best.pt
# auto | cpu | 0  — "auto" uses CUDA if torch.cuda.is_available(), else CPU.
AI_DEVICE=auto
AI_DETECTION_CONFIDENCE=0.25

# --- CORS ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://127.0.0.1:19000

# --- App ---
ENVIRONMENT=development
DEMO_MODE=true
API_V1_PREFIX=/api

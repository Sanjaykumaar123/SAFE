# Copy to .env and fill in for your environment. Never commit the real .env.

# --- Database (PostgreSQL + PostGIS) ---
# Local docker-compose default — see docker-compose.yml at repo root.
DATABASE_URL=postgresql+asyncpg://safepath:safepath@localhost:5433/safepath
# Used by Alembic (sync driver) — same DB, psycopg driver.
DATABASE_URL_SYNC=postgresql+psycopg://safepath:safepath@localhost:5433/safepath

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage ---
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./media
STORAGE_LOCAL_BASE_URL=http://localhost:8000/media
# Only required when STORAGE_PROVIDER=s3 (Supabase Storage or any S3-compatible endpoint)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- AI ---
# mock | yolov8 — yolov8 runs the real, bundled BharatPotHole-finetuned
# YOLO26n checkpoint in-process (see app/services/ai/yolo_service.py).
# Requires `pip install -r requirements.txt` to have installed ultralytics/
# torch (heavy — a GPU build of torch is recommended but not required, see
# AI_DEVICE below).
AI_PROVIDER=yolov8
# URL of running ./ai_model server microservice API (e.g. http://localhost:8001 or deployed AI endpoint)
AI_SERVER_URL=http://localhost:8001
# Only read when AI_PROVIDER=yolov8. Relative to backend/api/, or absolute
# — point this at a different checkpoint (e.g. a later training run) to
# swap models without any code change.
AI_MODEL_PATH=app/ml_models/pothole_v2_final.pt
# auto | cpu | 0  — "auto" uses CUDA if torch.cuda.is_available(), else CPU.
AI_DEVICE=auto
AI_DETECTION_CONFIDENCE=0.25

# --- CORS ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://127.0.0.1:19000

# --- App ---
ENVIRONMENT=development
DEMO_MODE=true
API_V1_PREFIX=/api
